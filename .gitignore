# dependencies (en cualquier paquete: packages/*, apps/*)
node_modules/

# next.js
/.next/
/.next-build-check/
/out/
/build

# env: cualquier `.env.<algo>` (p. ej. el `.env.production` de `vercel env pull`) queda fuera; solo la plantilla se versiona (H-109)
.env
.env.*
!.env.example

# certificados y claves privadas (el certificado de Apple Wallet es un .p12)
*.p12
*.pfx
*.key
*.keystore
*.jks
*.mobileprovision

# testing
/coverage
/loadtest/.fixtures.json

# misc
.DS_Store
*.pem
npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# pdf.js worker (se copia desde node_modules al arrancar Next)
/public/pdf.worker.min.mjs

# vercel
.vercel

# prisma
/prisma/*.db

# claude code / agent tooling (local, not project source)
/.claude/
/.agents/
/.impeccable/
skills-lock.json

# Directorios de build alternativos (NEXT_DIST_DIR) usados al verificar
/.next-*/
