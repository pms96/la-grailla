generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Conexión pooleada (p. ej. la URL "-pooler" de Neon) — la que usa la app
  // en caliente. Con Vercel serverless, cada invocación puede abrir su
  // propia conexión; sin pool delante, un pico de tráfico agota
  // max_connections de Postgres en segundos.
  url       = env("DATABASE_URL")
  // Conexión directa (sin pool) — Prisma la necesita para `migrate`/`db push`,
  // que usan prepared statements incompatibles con el modo transacción de
  // PgBouncer/Neon pooler. Si no vas a poolear (VPS propio sin pooler),
  // puedes apuntar ambas a la misma URL.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  TAQUILLA
  USER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  FINISHED
  CANCELLED
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD
  CASH
  FREE
}

enum TicketStatus {
  PENDING
  VALID
  USED
  CANCELLED
  REFUNDED
}

enum ShopOrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum SponsorRequestStatus {
  PENDING
  CONTACTED
  ACCEPTED
  REJECTED
}

model User {
  id                String                @id @default(cuid())
  name              String?
  email             String                @unique
  emailVerified     DateTime?
  hashedPassword    String?
  image             String?
  role              UserRole              @default(USER)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  accounts          Account[]
  sessions          Session[]
  scanLogs          ScanLog[]
  promptApprovals   SponsorVideoPrompt[]  @relation("SponsorPromptApprovals")
  promptGenerations PromptGenerationLog[] @relation("SponsorPromptGenerations")
  gastosCreados     Gasto[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id                               String             @id @default(cuid())
  name                             String
  slug                             String             @unique
  description                      String?            @db.Text
  venue                            String
  city                             String
  address                          String?
  imageUrl                         String?
  artists                          String?            @db.Text
  date                             DateTime
  doorsOpen                        String?
  endTime                          String?
  minAge                           Int                @default(18)
  conditions                       String?            @db.Text
  maxCapacity                      Int                @default(500)
  currentCount                     Int                @default(0)
  maxTicketsPerEmail               Int?
  waitingRoomEnabled               Boolean            @default(false)
  waitingRoomConcurrentSlots       Int?
  waitingRoomPurchaseWindowSeconds Int?
  waitingRoomMessage               String?            @db.Text
  status                           EventStatus        @default(DRAFT)
  alertAt80                        Boolean            @default(true)
  alertAt95                        Boolean            @default(true)
  alertThresholds                  String             @default("80,95,100")
  alertsSent                       String             @default("")
  latitude                         Float?
  longitude                        Float?
  // Vínculo opcional a la temporada de Compras/Gastos a la que pertenece este
  // evento (negocio de entradas), para poder calcular ingresos/margen reales
  // por temporada. Null = evento sin asignar todavía; se enlaza manualmente
  // desde la UI, sin backfill automático.
  temporadaId                      String?
  archivado                        Boolean            @default(false)
  createdAt                        DateTime           @default(now())
  updatedAt                        DateTime           @updatedAt
  temporada                        Temporada?         @relation(fields: [temporadaId], references: [id])
  ticketTypes                      TicketType[]
  orders                           Order[]
  tickets                          Ticket[]
  scanLogs                         ScanLog[]
  guestLists                       GuestList[]
  invitations                      Invitation[]
  waitingRoomEntries               WaitingRoomEntry[]

  @@index([temporadaId])
}

enum WaitingRoomStatus {
  WAITING
  ADMITTED
  COMPLETED
  EXPIRED
}

model WaitingRoomEntry {
  id         String            @id @default(cuid())
  eventId    String
  token      String            @unique
  // IP de quien entró a la cola — nada que ver con el lock de compra, solo
  // sirve para el límite anti-bot de abajo (join/route.ts): sin esto, un
  // script podría abrir cientos de "personas" en la cola desde la misma
  // máquina sin que el rate limit por minuto (pensado para ráfagas, no para
  // volumen sostenido) lo note.
  ip         String?
  status     WaitingRoomStatus @default(WAITING)
  joinedAt   DateTime          @default(now())
  admittedAt DateTime?
  expiresAt  DateTime?
  event      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, status, joinedAt])
  @@index([eventId, ip, status])
}

model TicketType {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  description String?
  price       Float
  phase       Int      @default(1)
  phaseName   String?  @default("Venta General")
  maxQuantity Int      @default(100)
  soldCount   Int      @default(0)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets     Ticket[]

  @@index([eventId])
}

model Order {
  id              String        @id @default(cuid())
  eventId         String
  buyerName       String
  buyerLastName   String
  buyerEmail      String
  totalAmount     Float
  commission      Float         @default(0)
  paymentMethod   PaymentMethod @default(CARD)
  paymentProvider String?
  paymentId       String?
  status          OrderStatus   @default(PENDING)
  // Clave que manda el frontend para que un reintento (doble clic antes de
  // que se desactive el botón, reintento de red, "atrás" + reenviar) nunca
  // cree un segundo pedido/cobro para la misma intención de compra. Se
  // limpia a null si el pedido se cancela (p. ej. fallo de la pasarela) para
  // que un reintento genuino con la misma clave no choque contra un pedido
  // ya muerto.
  idempotencyKey  String?       @unique
  soldById        String?
  channel         String        @default("ONLINE")
  pdfUrl          String?
  emailSentAt     DateTime?
  emailLastError  String?
  emailAttempts   Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  event           Event         @relation(fields: [eventId], references: [id])
  tickets         Ticket[]
  invitation      Invitation?

  @@index([eventId])
  @@index([buyerEmail])
  @@index([paymentId])
  @@index([status, emailSentAt])
}

model Ticket {
  id           String       @id @default(cuid())
  orderId      String
  eventId      String
  ticketTypeId String?
  qrCode       String       @unique
  holderName   String
  status       TicketStatus @default(VALID)
  entryTime    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id])
  ticketType   TicketType?  @relation(fields: [ticketTypeId], references: [id])
  scanLogs     ScanLog[]

  @@index([qrCode])
  @@index([eventId])
  @@index([orderId])
}

model ScanLog {
  id        String   @id @default(cuid())
  ticketId  String
  eventId   String
  scannerId String?
  result    String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])
  scanner   User?    @relation(fields: [scannerId], references: [id])

  @@index([ticketId])
  @@index([eventId])
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?          @db.Text
  price       Float
  imageUrl    String?
  images      String[]         @default([])
  category    String?
  sizes       String?
  colors      String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  orderItems  ShopOrderItem[]
  variants    ProductVariant[]
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  size      String  @default("")
  color     String  @default("")
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size, color])
  @@index([productId])
}

model ShopOrder {
  id              String          @id @default(cuid())
  buyerName       String
  buyerEmail      String
  shippingAddress String          @db.Text
  shippingCity    String
  shippingZip     String
  shippingPhone   String?
  totalAmount     Float
  paymentProvider String?
  paymentId       String?
  status          ShopOrderStatus @default(PENDING)
  trackingNumber  String?
  notes           String?
  idempotencyKey  String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  items           ShopOrderItem[]

  @@index([buyerEmail])
}

model ShopOrderItem {
  id          String    @id @default(cuid())
  shopOrderId String
  productId   String
  quantity    Int       @default(1)
  unitPrice   Float
  size        String?
  color       String?
  shopOrder   ShopOrder @relation(fields: [shopOrderId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@index([shopOrderId])
}

model SponsorRequest {
  id          String               @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String?
  website     String?
  sponsorType String
  message     String?              @db.Text
  status      SponsorRequestStatus @default(PENDING)
  adminNotes  String?              @db.Text
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  sponsor     Sponsor?
}

enum SponsorPortalStatus {
  PENDIENTE_MATERIALES
  PENDIENTE_REVISION
  LISTO_PARA_GENERAR
  PROMPT_GENERADO
  APROBADO_PARA_VIDEO
  RECHAZADO
}

// Se crea al aceptar un SponsorRequest — el lead (SponsorRequest) no se toca,
// esto es el ciclo de vida aparte del portal de materiales + prompt de vídeo.
model Sponsor {
  id               String              @id @default(cuid())
  sponsorRequestId String              @unique
  status           SponsorPortalStatus @default(PENDIENTE_MATERIALES)
  guidedAnswers    Json?
  freeText         String?             @db.Text
  // Investigación de marca que el ADMIN añade (web, redes, a qué se dedica de
  // verdad) antes de generar — sin esto, la IA solo veía el logo + 6
  // respuestas cortas y todos los vídeos salían con la misma estructura
  // genérica de "partículas convirtiéndose en logo", diera igual la marca.
  brandContext     String?             @db.Text
  currentAssetId   String?             @unique
  isGenerating     Boolean             @default(false)
  generationCount  Int                 @default(0)
  maxGenerations   Int                 @default(3)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  sponsorRequest SponsorRequest        @relation(fields: [sponsorRequestId], references: [id])
  currentAsset   SponsorAsset?         @relation("CurrentAsset", fields: [currentAssetId], references: [id])
  assets         SponsorAsset[]        @relation("SponsorAssets")
  videoPrompt    SponsorVideoPrompt?
  generationLogs PromptGenerationLog[]

  @@index([status])
}

// Nunca se borra ni se sobreescribe — cada subida es una fila nueva; Sponsor.currentAssetId
// apunta a la vigente, así queda "logo versionado" sin un sistema de versiones aparte.
model SponsorAsset {
  id         String   @id @default(cuid())
  sponsorId  String
  url        String
  fileType   String
  fileName   String
  fileSize   Int
  uploadedAt DateTime @default(now())

  sponsor    Sponsor  @relation("SponsorAssets", fields: [sponsorId], references: [id], onDelete: Cascade)
  currentFor Sponsor? @relation("CurrentAsset")

  @@index([sponsorId])
}

// Prompt "de trabajo": lo que devolvió la IA se guarda en PromptGenerationLog (inmutable);
// esto es lo que el admin edita a mano y aprueba, para no reescribir el historial de auditoría.
model SponsorVideoPrompt {
  id           String    @id @default(cuid())
  sponsorId    String    @unique
  promptEs     String    @db.Text
  promptEn     String    @db.Text
  sourceLogId  String?
  approvedAt   DateTime?
  approvedById String?
  notifiedAt   DateTime?
  updatedAt    DateTime  @updatedAt

  sponsor    Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  approvedBy User?   @relation("SponsorPromptApprovals", fields: [approvedById], references: [id])
}

// Historial inmutable de cada llamada a Abacus.AI, salga bien o mal — cuenta para el
// límite de 3 intentos por sponsor independientemente del resultado (el coste ya se generó).
model PromptGenerationLog {
  id                    String   @id @default(cuid())
  sponsorId             String
  attemptNumber         Int
  adminId               String?
  assetIdUsed           String?
  descriptionSnapshot   String?  @db.Text
  guidedAnswersSnapshot Json?
  rawResponse           Json?
  promptEs              String?  @db.Text
  promptEn              String?  @db.Text
  success               Boolean  @default(false)
  errorMessage          String?
  createdAt             DateTime @default(now())

  sponsor Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  admin   User?   @relation("SponsorPromptGenerations", fields: [adminId], references: [id])

  @@index([sponsorId])
}

model GuestList {
  id          String       @id @default(cuid())
  eventId     String
  name        String
  description String?
  ownerId     String?
  ownerName   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitations Invitation[]

  @@index([eventId])
}

model Invitation {
  id          String     @id @default(cuid())
  eventId     String
  listId      String?
  guestName   String
  guestEmail  String?
  quantity    Int        @default(1)
  notes       String?
  createdById String?
  orderId     String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  list        GuestList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([listId])
}

model AppConfig {
  id    String  @id @default(cuid())
  key   String  @unique
  value String  @db.Text
  label String?
  group String?

  @@index([key])
  @@index([group])
}

// Backing store del rate limiter (lib/rate-limit.ts). Antes vivía en un Map
// en memoria del proceso — en Vercel serverless cada instancia tiene su
// propia memoria y se recicla en cada cold start/deploy, así que un límite
// "10 por minuto" en realidad era "10 por minuto POR INSTANCIA viva", varias
// veces más permisivo de lo que la config sugiere. Postgres ya es la única
// pieza de infraestructura del proyecto — sin añadir Redis/Upstash, un solo
// UPSERT atómico por petición basta para un límite real y compartido.
model RateLimitBucket {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@index([resetAt])
}

// Stripe reintenta la entrega de un webhook si no respondemos 2xx a tiempo
// (timeout, deploy en curso, error transitorio) — el mismo `event.id` puede
// llegar más de una vez. Guardamos el id procesado con una constraint única:
// el segundo intento choca con P2002 y no se reprocesa. No hace falta TTL,
// el volumen de eventos de Stripe de esta tienda es bajo.
model ProcessedWebhookEvent {
  id          String   @id
  processedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Módulo de Compras y Gastos por Temporada — planificación de compras de la
// caseta de feria (bebidas y demás suministros) y contabilidad general de
// costes, agrupado por edición anual de la feria. Independiente del modelo
// Event (venta de entradas), que es un negocio aparte.
// ---------------------------------------------------------------------------

enum TemporadaStatus {
  ABIERTA
  CERRADA
}

enum PedidoStatus {
  BORRADOR
  ENVIADO
  RECIBIDO
}

model Temporada {
  id          String          @id @default(cuid())
  nombre      String
  anio        Int
  fechaInicio DateTime?
  fechaFin    DateTime?
  status      TemporadaStatus @default(ABIERTA)
  notas       String?         @db.Text
  archivado   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  consumos ConsumoHistorico[]
  planes   PlanCompra[]
  pedidos  Pedido[]
  gastos   Gasto[]
  eventos  Event[]

  @@index([anio])
}

model Proveedor {
  id        String   @id @default(cuid())
  nombre    String
  contacto  String?
  telefono  String?
  email     String?
  notas     String?  @db.Text
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  precios       PrecioArticulo[]
  planesElegido PlanCompra[]
  pedidos       Pedido[]
  gastos        Gasto[]
}

model Articulo {
  id              String   @id @default(cuid())
  nombre          String
  categoria       String
  formato         String
  unidadesPorCaja Int      @default(1)
  ivaPercent      Float    @default(21)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  precios      PrecioArticulo[]
  consumos     ConsumoHistorico[]
  planes       PlanCompra[]
  lineasPedido LineaPedido[]

  @@index([categoria])
}

model PrecioArticulo {
  id               String   @id @default(cuid())
  articuloId       String
  proveedorId      String
  precioSinIva     Float
  descuentoPercent Float    @default(0)
  formatoVenta     String
  unidadMinPedido  Int      @default(1)
  notas            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  articulo  Articulo  @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  proveedor Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Cascade)

  @@unique([articuloId, proveedorId])
  @@index([articuloId])
  @@index([proveedorId])
}

// Consumo neto de una temporada pasada, usado como referencia al planificar
// la siguiente — no se edita desde el planificador, solo se importa/corrige.
model ConsumoHistorico {
  id           String   @id @default(cuid())
  articuloId   String
  temporadaId  String
  cantidadNeta Float
  fuenteDatos  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  articulo  Articulo  @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  temporada Temporada @relation(fields: [temporadaId], references: [id], onDelete: Cascade)

  @@unique([articuloId, temporadaId])
  @@index([temporadaId])
}

// La intención de compra del admin para una temporada — separado del
// ConsumoHistorico (dato pasado, de solo lectura) y del Pedido ya generado
// (documento formal), para poder replanificar sin perder lo ya pedido.
model PlanCompra {
  id                  String   @id @default(cuid())
  temporadaId         String
  articuloId          String
  proveedorElegidoId  String?
  cantidadPlanificada Float    @default(0)
  observaciones       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  temporada        Temporada  @relation(fields: [temporadaId], references: [id], onDelete: Cascade)
  articulo         Articulo   @relation(fields: [articuloId], references: [id], onDelete: Cascade)
  proveedorElegido Proveedor? @relation(fields: [proveedorElegidoId], references: [id])

  @@unique([temporadaId, articuloId])
  @@index([temporadaId])
}

model Pedido {
  id            String       @id @default(cuid())
  temporadaId   String
  proveedorId   String
  status        PedidoStatus @default(BORRADOR)
  fechaPedido   DateTime     @default(now())
  fechaEnviado  DateTime?
  fechaRecibido DateTime?
  notas         String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  temporada Temporada     @relation(fields: [temporadaId], references: [id])
  proveedor Proveedor     @relation(fields: [proveedorId], references: [id])
  lineas    LineaPedido[]
  gasto     Gasto?

  @@index([temporadaId, status])
  @@index([proveedorId])
}

model LineaPedido {
  id               String @id @default(cuid())
  pedidoId         String
  articuloId       String
  cantidad         Float
  precioSinIva     Float
  descuentoPercent Float  @default(0)
  ivaPercent       Float

  pedido   Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  articulo Articulo @relation(fields: [articuloId], references: [id])

  @@index([pedidoId])
}

// El libro de contabilidad real de la caseta: cualquier coste (no solo
// bebida), opcionalmente ligado a un Proveedor y/o a un Pedido ya recibido.
// El importe puede ser negativo (abonos/devoluciones de proveedor).
model Gasto {
  id            String   @id @default(cuid())
  temporadaId   String
  categoria     String
  concepto      String
  proveedorId   String?
  pedidoId      String?  @unique
  importeSinIva Float
  ivaPercent    Float    @default(21)
  fecha         DateTime @default(now())
  numDocumento  String?
  tipoDocumento String   @default("Factura")
  notas         String?  @db.Text
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  temporada Temporada  @relation(fields: [temporadaId], references: [id])
  proveedor Proveedor? @relation(fields: [proveedorId], references: [id])
  pedido    Pedido?    @relation(fields: [pedidoId], references: [id])
  createdBy User?      @relation(fields: [createdById], references: [id])

  @@index([temporadaId, categoria])
  @@index([proveedorId])
}
