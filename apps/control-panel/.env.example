# BD de control (solo el proveedor). La directa se usa para migraciones.
CONTROL_DATABASE_URL=postgresql://user:pass@localhost:5432/lagrailla_control
CONTROL_DIRECT_URL=postgresql://user:pass@localhost:5432/lagrailla_control
# Claves maestras para sellar secretos (enc:v2): JSON {kid: 32 bytes en base64url}.
# Rotar = añadir un kid nuevo y poner SECRETS_ACTIVE_KID; los viejos siguen abriendo lo antiguo.
SECRETS_ACTIVE_KID=m1
SECRETS_KEYS={"m1":"<32 bytes base64url>"}
# Clave Ed25519 con la que se firman los snapshots (PKCS8 en base64url) y su kid.
SNAPSHOT_KID=s1
SNAPSHOT_SIGNING_KEY=<pkcs8 base64url>
# Almacén replicado que lee el front: upstash (siempre en un servidor). `memory` solo vale en tests y en desarrollo local:
# en producción es un error, porque publicaría en la memoria de cada instancia y el front no vería ningún cliente.
# Una base de Upstash por entorno (producción, pruebas): nunca compartas la de producción con otro entorno.
# En desarrollo, `npm run dev:registry` levanta un servidor compatible en 127.0.0.1:3113 con el token «dev».
REGISTRY_STORE=upstash
UPSTASH_REDIS_REST_URL=http://127.0.0.1:3113
UPSTASH_REDIS_REST_TOKEN=dev
