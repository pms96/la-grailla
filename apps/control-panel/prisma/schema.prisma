// BD de CONTROL del panel (solo el proveedor). No tiene nada que ver con las
// BDs de los clientes: aquí vive qué clientes hay, qué módulos tienen, sus
// dominios, y las URLs de sus BDs cifradas (enc:v2, nunca en claro).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("CONTROL_DATABASE_URL")
  directUrl = env("CONTROL_DIRECT_URL")
}

enum OperatorRole {
  VIEWER
  OPERATOR
  BILLING
  SUPERADMIN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
}

enum ModuleSource {
  MANUAL
  KEY
}

enum DomainStatus {
  PENDING
  VERIFIED
  RELEASED
}

enum MigrationRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  // No se lanzó porque otro cliente falló antes (parada ante fallo).
  SKIPPED
}

model Operator {
  id                 String            @id @default(cuid())
  email              String            @unique
  name               String
  role               OperatorRole
  passwordHash       String
  mustChangePassword Boolean           @default(true)
  // Secreto TOTP sellado (enc:v2) con AAD "operatorId|totp".
  totpSecretEnc      String?
  totpEnabledAt      DateTime?
  // Último intervalo de 30 s aceptado: impide reutilizar un código.
  totpLastStep       Int?
  // SHA-256 de cada código de recuperación (de un solo uso).
  recoveryCodeHashes String[]
  failedLogins       Int               @default(0)
  lockedUntil        DateTime?
  disabledAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  sessions           OperatorSession[]
}

model OperatorSession {
  id            String    @id @default(cuid())
  // SHA-256 del token de la cookie: un volcado de la BD no permite suplantar sesiones.
  tokenHash     String    @unique
  operatorId    String
  operator      Operator  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  // null = solo ha pasado la contraseña; todavía no puede usar el panel.
  mfaVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  ip            String?
  userAgent     String?

  @@index([operatorId])
  @@index([expiresAt])
}

model Product {
  key           String         @id
  name          String
  modules       ModuleDef[]
  subscriptions Subscription[]
}

model ModuleDef {
  productKey   String
  product      Product @relation(fields: [productKey], references: [key])
  key          String
  name         String
  isCore       Boolean @default(false)
  monthlyAddon Boolean @default(false)
  sortOrder    Int     @default(0)

  @@id([productKey, key])
}

model Tenant {
  // ULID inmutable: identidad del cliente. No se deriva del nombre ni del dominio.
  id            String         @id
  name          String
  status        TenantStatus   @default(ACTIVE)
  notes         String?
  // Revocación de emergencia: mientras no sea null, el front corta a este cliente en segundos (clave `revoked:{id}` del registro).
  emergencyRevokedAt DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id              String               @id @default(cuid())
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  productKey      String
  product         Product              @relation(fields: [productKey], references: [key])
  // Celda de despliegue: hoy una sola compartida.
  cell            String               @default("shared-1")
  status          SubscriptionStatus   @default(ACTIVE)
  // Sube para invalidar de golpe sesiones y tokens de este cliente.
  epoch           Int                  @default(0)
  // Contador del snapshot publicado (anti-replay).
  snapshotSeq     Int                  @default(0)
  schemaVersion   String?
  // Licencia: la cobertura termina en paidThrough (null = sin caducidad); después, graceDays de aviso, panelBlockedDays con el
  // panel bloqueado y, acumulado, bloqueo total (7 + 15 = 22 días por defecto).
  paidThrough     DateTime?
  graceDays       Int                  @default(7)
  panelBlockedDays Int                 @default(15)
  dbCluster       String               @default("neon-eu-1")
  dbRegion        String?
  // URLs de la BD del cliente, selladas (enc:v2). Nunca salen del panel en claro.
  dbUrlPooledEnc  String
  dbUrlDirectEnc  String
  // Huella de la BD (servidor + puerto + nombre): única, para que dos clientes no puedan apuntar a la misma BD (ver lib/services/db-identity.ts).
  // Null en altas anteriores: se rellena al registrar el siguiente cliente.
  dbFingerprint   String?              @unique
  // Hash del registro publicado (sin seq/iat): detecta "cambios sin publicar".
  lastPublishedHash String?
  lastPublishedAt DateTime?
  lastPublishError String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  modules         SubscriptionModule[]
  domains         Domain[]
  migrationRuns   MigrationRun[]
  cronStates      CronState[]
  health          TenantHealth?

  @@unique([tenantId, productKey])
}

model SubscriptionModule {
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  moduleKey      String
  source         ModuleSource @default(MANUAL)
  enabledAt      DateTime     @default(now())
  enabledBy      String?

  @@id([subscriptionId, moduleKey])
}

model Domain {
  id                String       @id @default(cuid())
  // Normalizado y único en TODO el sistema. Al liberarlo la fila queda como
  // "lápida" (RELEASED) para que otro cliente no pueda reclamarlo de inmediato.
  host              String       @unique
  subscriptionId    String
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])
  isPrimary         Boolean      @default(false)
  status            DomainStatus @default(PENDING)
  verificationToken String
  verifiedAt        DateTime?
  releasedAt        DateTime?
  createdAt         DateTime     @default(now())

  @@index([subscriptionId])
}

model AuditLog {
  id            BigInt   @id @default(autoincrement())
  at            DateTime @default(now())
  operatorId    String?
  operatorEmail String
  action        String
  targetType    String
  targetId      String
  tenantId      String?
  ip            String?
  userAgent     String?
  meta          Json     @default("{}")
  // Cadena de hashes: cada fila incluye el hash de la anterior, así borrar o
  // editar una fila rompe la verificación de todas las siguientes.
  prevHash      String
  hash          String

  @@index([tenantId, id])
  @@index([operatorId, id])
}

// Código canjeable que amplía los derechos de una suscripción (módulos y/o vigencia). Solo se guarda el hash: el código en claro se
// muestra una vez al crearlo.
model LicenseKey {
  id                       String    @id @default(cuid())
  codeHash                 String    @unique
  // Primeros caracteres, para reconocer una clave en la lista sin poder reconstruirla.
  codePrefix               String
  modules                  String[]
  extendDays               Int       @default(0)
  note                     String?
  createdBy                String
  createdAt                DateTime  @default(now())
  expiresAt                DateTime?
  redeemedAt               DateTime?
  redeemedBySubscriptionId String?
  redeemedBy               String?

  @@index([redeemedAt])
}

// Una ejecución del runner de migraciones sobre la BD de UN cliente. Nunca guarda URLs ni credenciales.
model MigrationRun {
  id              String             @id @default(cuid())
  subscriptionId  String
  subscription    Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenantId        String
  status          MigrationRunStatus @default(RUNNING)
  dryRun          Boolean            @default(false)
  // Última migración aplicada ANTES y DESPUÉS (nombre de carpeta).
  fromVersion     String?
  toVersion       String?
  // Las que esta ejecución debía aplicar (o aplicó).
  pending         String[]
  attempts        Int                @default(0)
  error           String?
  triggeredBy     String
  startedAt       DateTime           @default(now())
  finishedAt      DateTime?

  @@index([subscriptionId, startedAt])
  @@index([status])
}

// Estado de cada tarea periódica por cliente. `nextRunAt` hace que un cliente que falla se espacie solo (backoff) sin bloquear a los demás.
model CronState {
  subscriptionId      String
  subscription        Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  job                 String
  lastRunAt           DateTime?
  lastSuccessAt       DateTime?
  lastStatus          String?
  lastHttp            Int?
  lastDurationMs      Int?
  lastError           String?
  consecutiveFailures Int          @default(0)
  nextRunAt           DateTime     @default(now())

  @@id([subscriptionId, job])
  @@index([job, nextRunAt])
}

// Última comprobación de salud del cliente (la rellena la tarea `health`).
model TenantHealth {
  subscriptionId  String       @id
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  checkedAt       DateTime
  ok              Boolean
  status          String
  httpStatus      Int?
  latencyMs       Int?
  dbOk            Boolean?
  schemaApplied   String?
  schemaExpected  String?
  schemaUpToDate  Boolean?
  onboardingComplete Boolean?
  onboardingMissing  String[]
  version         String?
  error           String?
}
