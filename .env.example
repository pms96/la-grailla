# Copia este archivo a .env y rellena los valores. Nunca subas .env con
# credenciales reales a ningún repositorio.

# BD local levantada con `docker compose up -d` (ver docker-compose.yml).
# En producción con Vercel + Neon: usa la connection string CON "-pooler"
# (imprescindible en serverless — sin pool, un pico de tráfico agota las
# conexiones de Postgres en segundos).
DATABASE_URL='postgresql://lagrailla:lagrailla@localhost:5432/lagrailla?connect_timeout=15'

# Prisma la necesita para `migrate`/`db push` (usan prepared statements que el
# pool en modo transacción no soporta). En Neon: la connection string SIN
# "-pooler". En local: la misma que DATABASE_URL.
DIRECT_URL='postgresql://lagrailla:lagrailla@localhost:5432/lagrailla?connect_timeout=15'

# Secreto de NextAuth para firmar sesiones — genera uno propio, no reutilices
# el de otro entorno. Ejemplo: `openssl rand -base64 32`
NEXTAUTH_SECRET=

# URL pública de la app. En local: http://localhost:3000
# En el servidor de despliegue: la URL real (https://tudominio.com)
NEXTAUTH_URL=http://localhost:3000

# Credenciales del admin que crea `npx prisma db seed` (scripts/seed.ts).
# Define un email y contraseña propios — nunca reutilices un valor de ejemplo.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cuenta de admin secundaria opcional (solo se crea si ambas están definidas).
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Las credenciales de pasarelas de pago (Stripe/SumUp), SMTP y wallets NO se
# configuran aquí — se gestionan desde /admin/configuracion una vez la app
# está en marcha, y se guardan cifradas en base de datos (ver lib/secrets.ts).

# Protege /api/cron/reconcile-payments de que cualquiera pueda invocarlo.
# El disparador es un workflow de GitHub Actions (.github/workflows/
# reconcile-payments.yml, cada 5 min — Vercel Cron en el plan Hobby solo
# permite tareas diarias), que manda "Authorization: Bearer <CRON_SECRET>".
# Define el MISMO valor aquí (como variable de entorno de Vercel) y como
# secret "CRON_SECRET" en la configuración del repo de GitHub (Settings →
# Secrets and variables → Actions). Genera uno con `openssl rand -base64 32`.
CRON_SECRET=

# Subida de imágenes (eventos y productos) vía Vercel Blob Storage. Activa el
# Blob Store desde el dashboard de Vercel (Storage → Create → Blob) y esta
# variable se inyecta sola en producción — no hace falta rellenarla a mano
# salvo que quieras probar la subida de imágenes en local (en ese caso, copia
# el token desde Vercel → Settings → Environment Variables).
BLOB_READ_WRITE_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# MODO PLATAFORMA (proyecto de Vercel `platform`: un front para varios clientes, cada uno con su dominio y su BD).
# NO se definen en el proyecto de La Grailla de siempre (modo normal). En `platform`, NO definas DATABASE_URL, DIRECT_URL, NEXTAUTH_SECRET
# ni NEXTAUTH_URL: no existe un valor global, cada cliente trae los suyos desde el registro (`npm run platform:preflight` lo comprueba).
# Todas, solo en el entorno «Production» de Vercel y marcadas «Sensitive» (nunca en «Preview»). Genera cada clave de 32 bytes con:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
# Detalle y orden de despliegue: docs/platform/m7-operacion.md (apartado 6).
# ──────────────────────────────────────────────────────────────────────────────
# PLATFORM_MODE=on
# PLATFORM_PRODUCT=grailla
# Registro de clientes (Upstash, UNA base por entorno). El front lee SIEMPRE con el token de SOLO LECTURA.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_READ_ONLY_TOKEN=
# Claves públicas con las que se verifican los snapshots firmados por el panel: {"kid":"<clave pública base64url>"}
# SNAPSHOT_PUBKEYS=
# Caducidad dura de un snapshot (días, 30 por defecto).
# SNAPSHOT_MAX_AGE_DAYS=30
# Claves de 32 bytes (todas distintas entre sí). PLATFORM_CRON_MASTER es la MISMA que en el panel.
# PLATFORM_CONTEXT_KEY=
# PLATFORM_SESSION_MASTER=
# PLATFORM_CRON_MASTER=
# Claves con las que se abren las URLs de BD de los clientes: {"kid":"<32 bytes base64url>"} y el kid activo. MISMAS que en el panel.
# SECRETS_KEYS=
# SECRETS_ACTIVE_KID=
# Cliente anterior a la plataforma (La Grailla): su id y el NEXTAUTH_SECRET que ya usa (para no cerrar las sesiones activas).
# LEGACY_TENANT_ID=
# LEGACY_NEXTAUTH_SECRET=
# Contacto del proveedor de la plataforma para los avisos de licencia (aviso de gracia del panel y pantalla /licencia). Opcionales y públicos
# (se muestran en pantalla; no son secretos). Sin ellos, los avisos dicen «ponte en contacto con tu proveedor de la plataforma».
# PLATFORM_SUPPORT_EMAIL=
# PLATFORM_SUPPORT_URL=

# ─────────────────────────────────────────────────────────────────
# OBSERVABILIDAD (P0-07), tanto en el proyecto `platform` como en el antiguo `la-grailla`. Todas opcionales y SIN valor por defecto: sin ellas el
# comportamiento es exactamente el de siempre. Marcarlas «Sensitive» en Vercel. Detalle y política de datos: docs/platform/observabilidad.md.
# ─────────────────────────────────────────────────────────────────
# Captura de errores del servidor (Sentry, solo servidor y sin SDK de navegador). DSN de un proyecto de Sentry en REGIÓN UE (…ingest.de.sentry.io).
# SENTRY_DSN=
# Alertas del OPERADOR, independientes del SMTP del cliente: URL https de un tema de ntfy (o de un webhook de Slack/Discord/JSON) y, si el tema
# o el webhook tiene control de acceso, su token (se envía como `Authorization: Bearer`). La URL es un secreto. Sin URL no se envía nada.
# PLATFORM_ALERT_URL=
# PLATFORM_ALERT_TOKEN=
